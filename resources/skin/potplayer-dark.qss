/*
 * PotPlayer-style modern dark skin.
 *
 * Palette:
 *   window      #1b1b1b   panels   #202020   raised  #2a2a2a
 *   border      #2f2f2f   hover    #333333   pressed #3d3d3d
 *   text        #d6d6d6   muted    #8a8a8a   accent  #ffb41e (amber)
 */

* {
    font-size: 9pt;
}

QMainWindow,
#RootWidget {
    background: #1b1b1b;
}

/* ---- Title bar ---------------------------------------------------------- */

#TitleBar {
    background: #1b1b1b;
    border-bottom: 1px solid #262626;
    min-height: 28px;
    max-height: 28px;
}

#AppNameLabel {
    color: #ffb41e;
    font-weight: bold;
}

#TitleLabel {
    color: #a8a8a8;
}

#TitleBar QToolButton {
    border: none;
    border-radius: 0;
    min-width: 40px;
    min-height: 28px;
}

#TitleBar QToolButton:hover {
    background: #333333;
}

#TitleBar QToolButton#CloseButton:hover {
    background: #c42b1c;
}

/* ---- Control bar -------------------------------------------------------- */

#ControlBar {
    background: #202020;
    border-top: 1px solid #2a2a2a;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 4px;
}

QToolButton:hover {
    background: #333333;
}

QToolButton:pressed {
    background: #3d3d3d;
}

QToolButton:checked {
    background: #2e2a22;
    border-bottom: 2px solid #ffb41e;
}

#ControlBar QToolButton#PlayButton {
    padding: 5px 7px;
}

#TimeLabel {
    color: #d6d6d6;
    font-family: "DejaVu Sans Mono", "Noto Sans Mono", monospace;
}

/* Custom-painted seekbar: colors are exposed as properties. */
SeekBar {
    qproperty-grooveColor: #3a3a3a;
    qproperty-progressColor: #ffb41e;
    qproperty-hoverColor: rgba(255, 255, 255, 50);
    qproperty-handleColor: #f0f0f0;
    qproperty-chapterColor: #202020;
    min-height: 18px;
}

/* ---- Empty state (start screen) ----------------------------------------- */

#EmptyStateTitle {
    font-size: 20pt;
    font-weight: bold;
}

#EmptyStateTitle[compact="true"] {
    font-size: 14pt;
}

#EmptyStateHint {
    color: #7a7a7a;
    font-size: 9pt;
}

#EmptyStateHint[dropTarget="true"] {
    color: #ffb41e;
}

QPushButton[emptyStateAction="true"] {
    background: #262626;
    color: #d6d6d6;
    border: 1px solid #343434;
    border-radius: 6px;
    padding: 9px 18px 9px 14px;
    min-width: 168px;
    min-height: 22px;
    text-align: left;
    font-size: 10pt;
}

QPushButton[emptyStateAction="true"][compact="true"] {
    min-width: 0;
    padding: 9px;
}

QPushButton[emptyStateAction="true"]:hover {
    background: #2e2a22;
    border-color: #ffb41e;
    color: #ffffff;
}

QPushButton[emptyStateAction="true"]:pressed {
    background: #3a3122;
}

/* ---- Volume slider ------------------------------------------------------ */

QSlider#VolumeSlider::groove:horizontal {
    height: 4px;
    background: #3a3a3a;
    border-radius: 2px;
}

QSlider#VolumeSlider::sub-page:horizontal {
    background: #ffb41e;
    border-radius: 2px;
}

QSlider#VolumeSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -3px 0;
    border-radius: 5px;
    background: #e6e6e6;
}

QSlider#VolumeSlider::handle:horizontal:hover {
    background: #ffffff;
}

/* ---- Playlist drawer ---------------------------------------------------- */

#PlaylistDrawer {
    background: #181818;
    border-left: 1px solid #2a2a2a;
}

#PlaylistResizeHandle {
    background: transparent;
}

#PlaylistResizeHandle:hover {
    background: rgba(255, 180, 30, 0.35);
}

QTabBar#PlaylistTabs::tab {
    background: transparent;
    color: #8a8a8a;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 4px 8px;
    font-weight: bold;
}

QTabBar#PlaylistTabs::tab:hover {
    color: #d6d6d6;
}

QTabBar#PlaylistTabs::tab:selected {
    color: #d6d6d6;
    border-bottom-color: #ffb41e;
}

#PlaylistCount {
    color: #8a8a8a;
}

QLineEdit#PlaylistFilter {
    background: #222222;
    color: #d6d6d6;
    border: 1px solid #2f2f2f;
    border-radius: 3px;
    padding: 2px 4px;
    selection-background-color: #ffb41e;
    selection-color: #111111;
}

QLineEdit#PlaylistFilter:focus {
    border-color: #ffb41e;
}

#PlaylistDrawer QToolButton[hideMenuIndicator="true"]::menu-indicator {
    image: none;
    width: 0;
}

QListWidget#PlaylistView {
    background: #181818;
    color: #c8c8c8;
    border: none;
    border-top: 1px solid #262626;
    outline: none;
    padding: 2px 0;
}

QListWidget#PlaylistView::item {
    padding: 5px 10px;
    border: none;
}

QListWidget#PlaylistView::item:hover {
    background: #242424;
}

QListWidget#PlaylistView::item:selected {
    background: #2f2f2f;
    color: #ffffff;
}

QTreeWidget#LibraryView {
    background: #181818;
    color: #c8c8c8;
    border: none;
    border-top: 1px solid #262626;
    outline: none;
    padding: 2px 0;
}

QTreeWidget#LibraryView::item {
    padding: 4px 2px;
    border: none;
}

QTreeWidget#LibraryView::item:hover {
    background: #242424;
}

QTreeWidget#LibraryView::item:selected {
    background: #2f2f2f;
    color: #ffffff;
}

/* ---- Menus -------------------------------------------------------------- */

QMenu {
    background: #1f1f1f;
    color: #d6d6d6;
    border: 1px solid #3a3a3a;
    padding: 4px 0;
}

QMenu::item {
    padding: 5px 28px 5px 26px;
    background: transparent;
}

QMenu::item:selected {
    background: #3a3a3a;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #5a5a5a;
}

QMenu::separator {
    height: 1px;
    background: #333333;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 12px;
    height: 12px;
    left: 8px;
}

QMenu::indicator:non-exclusive:checked,
QMenu::indicator:exclusive:checked {
    background: #ffb41e;
    border-radius: 2px;
}

QMenu::indicator:exclusive:checked {
    border-radius: 6px;
}

QMenu::right-arrow {
    width: 8px;
    height: 8px;
}

/* ---- Scroll bars -------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4a4a;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    height: 0;
    width: 0;
}

/* ---- Tooltips ----------------------------------------------------------- */

QToolTip {
    background: #262626;
    color: #d6d6d6;
    border: 1px solid #3a3a3a;
    padding: 3px 6px;
}

/* ---- Subtitle download dialog ------------------------------------------- */

QTreeWidget#SubtitleResults {
    background: #181818;
    alternate-background-color: #1d1d1d;
    color: #d6d6d6;
    border: 1px solid #2a2a2a;
    outline: none;
}

QTreeWidget#SubtitleResults::item {
    padding: 5px 6px;
    border: none;
}

QTreeWidget#SubtitleResults::item:hover {
    background: #242424;
}

QTreeWidget#SubtitleResults::item:selected {
    background: #33302a;
    color: #ffffff;
}

QTreeWidget#SubtitleResults QHeaderView::section {
    background: #222222;
    color: #9a9a9a;
    border: none;
    border-right: 1px solid #2a2a2a;
    border-bottom: 1px solid #2a2a2a;
    padding: 5px 6px;
}

QProgressBar#SubtitleProgress {
    background: #262626;
    border: none;
    border-radius: 2px;
}

QProgressBar#SubtitleProgress::chunk {
    background: #ffb41e;
    border-radius: 2px;
}
