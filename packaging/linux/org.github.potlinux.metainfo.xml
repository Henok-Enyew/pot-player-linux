<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.github.potlinux</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Pot Player</name>
  <summary>Lightweight media player with a PotPlayer-style interface</summary>
  <description>
    <p>
      Pot Player is a Qt6 media player for Linux built on libmpv. It brings
      the look and keyboard workflow of PotPlayer to the Linux desktop.
    </p>
    <ul>
      <li>Borderless dark skin with an on-screen display</li>
      <li>Seekbar with hover preview thumbnails</li>
      <li>Drag-and-drop playlist drawer</li>
      <li>Dual subtitles, subtitle delay and position hotkeys</li>
      <li>Hardware-accelerated decoding through mpv</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.github.potlinux.desktop</launchable>
  <provides>
    <binary>pot-player</binary>
  </provides>
  <url type="homepage">https://github.com/henok-enyew/pot-player-linux</url>
  <url type="bugtracker">https://github.com/henok-enyew/pot-player-linux/issues</url>
  <developer id="io.github.henok-enyew">
    <name>pot-player-linux contributors</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-10-02"/>
  </releases>
</component>
